Goal: Documentation of runtime configuration.

Rule: NEVER commit the real .env. NEVER EVER commit the real .env.local

Structure: List every supported environment variable with safe dummy defaults or comments explaining them.

LLM_BASE_URL="htp://service:port/entry" # like http://inference:11434/v1
LLM_MODEL_NAME="model_name:param" # like llama3.1:8b

VECTOR_DB_PATH="/path/to/db" # like "/app/db/chroma"
EMBEDDING_MODEL="text-embedding-model" # like text-embedding-3-small

EYE_ENV=ambient # production or development
